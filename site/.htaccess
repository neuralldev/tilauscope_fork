# tilauscope.org — Apache header layer.
#
# _headers (Cloudflare Pages / Netlify syntax) never applies on IONOS Espace
# Web: the front end is nginx, but the actual document root is served through
# an Apache-compatible layer that DOES read .htaccess — this file is what
# actually reaches the browser on this host. Without it, only the weaker
# <meta http-equiv="Content-Security-Policy"> in index.html is in effect: no
# HSTS, no X-Frame-Options, no frame-ancestors, no Permissions-Policy, because
# none of those can be expressed as a <meta> tag at all.
#
# Verify after upload:
#   curl -sI https://tilauscope.org | grep -iE 'strict-transport|x-frame|content-security|permissions-policy'
#
# TLS topology: the domain is DNS-proxied through Cloudflare in *Flexible* SSL
# mode. Cloudflare terminates HTTPS for the visitor using its own edge
# certificate; the Cloudflare→origin hop behind it is still plain HTTP,
# because IONOS itself presents no certificate on port 443. Two consequences:
#
#   * Do NOT add an origin-side http→https redirect here (no `RewriteCond
#     %{HTTPS} off` block). Behind Flexible mode, every request Apache sees is
#     HTTP regardless of what the visitor's browser used, so such a rule would
#     redirect Cloudflare's own request back to itself — Cloudflare re-fetches
#     over HTTP again, %{HTTPS} is off again, and the loop is infinite from
#     the visitor's side (ERR_TOO_MANY_REDIRECTS). The http→https upgrade is
#     handled at the edge instead — Cloudflare dashboard → SSL/TLS → Edge
#     Certificates → "Always Use HTTPS".
#   * `Strict-Transport-Security` is safe to send now: it travels through
#     Cloudflare unchanged and reaches the visitor over the real HTTPS
#     connection they made to the edge. `preload` is left out on purpose — it
#     is a one-way door (once submitted, browsers refuse HTTP outright for the
#     whole domain, including any future subdomain), and worth adding only
#     once the origin itself is known-stable on HTTPS. Re-evaluate if/when the
#     Cloudflare SSL/TLS mode moves to Full or Full (strict) with a real
#     origin certificate.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Fonts are renamed rather than revalidated when they change, so caching
  # them hard costs nothing. index.html gets the opposite treatment: it must
  # go stale within the hour, or a correction to the attribution notice would
  # take a year to reach anybody.
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

ServerSignature Off
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Kept as a fallback in case a future upload ever loses the real
  # .well-known/security.txt directory again — RFC 9116 explicitly allows
  # serving the file from elsewhere via redirect, this is not a hack.
  RewriteCond %{REQUEST_URI} ^/\.well-known/security\.txt$
  RewriteCond %{DOCUMENT_ROOT}/.well-known/security.txt !-f
  RewriteRule ^ /security.txt [L]
</IfModule>
